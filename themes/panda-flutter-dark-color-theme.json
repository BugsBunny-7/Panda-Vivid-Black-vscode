  "tokenColors": [
    {
      "name": "Plain text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#909CC3",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "keyword.operator.closure.dart"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.declaration",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.cast.dart",
        "keyword.new.dart",
        "keyword.other.import.dart",
        "storage.type.primitive.dart",
        "variable.language.this",
        "variable.language.super",
        "variable.language.dart",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#50E191"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.class.dart",
        "entity.name.type.dart",
        "storage.type.primitive",
        "support.type.primitive",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.alias",
        "entity.name.type.parameter",
        "storage.type.java",
        "storage.type.cs",
        "storage.type.go",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#FF916E"
      }
    },
    {
      "name": "Atoms",
      "scope": [
        "constant.language",
        "constant.language.dart",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant.property-value",
        "support.constant.color",
        "support.constant.font-name",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#FF916E"
      }
    },
    {
      "name": "Identifiers, functions, properties, parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "variable.parameter.dart",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.constant",
        "variable.other.enummember",
        "variable.object.property",
        "entity.name.function",
        "entity.name.function.dart",
        "support.function",
        "support.variable",
        "support.variable.property",
        "meta.function-call",
        "meta.object-literal.key",
        "entity.name.variable",
        "entity.name.constant",
        "meta.definition.variable",
        "meta.definition.property"
      ],
      "settings": {
        "foreground": "#00D2FA"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FA557D"
      }
    },
    {
      "name": "String interpolation and special strings",
      "scope": [
        "meta.embedded.expression.dart",
        "constant.character.escape",
        "constant.character",
        "constant.other.placeholder",
        "string.regexp",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression punctuation"
      ],
      "settings": {
        "foreground": "#FF00FA"
      }
    },
    {
      "name": "Dart interpolated identifier",
      "scope": [
        "meta.embedded.expression.dart variable.parameter.dart"
      ],
      "settings": {
        "foreground": "#00D2FA"
      }
    },
    {
      "name": "Template expression contents",
      "scope": [
        "meta.template.expression",
        "meta.embedded.expression.dart meta.embedded.expression.dart"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit",
        "constant.numeric.dart"
      ],
      "settings": {
        "foreground": "#AFCEA2"
      }
    },
    {
      "name": "Annotations and meta",
      "scope": [
        "storage.type.annotation",
        "storage.type.annotation.dart",
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.annotation",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "meta.attribute",
        "meta.preprocessor.script.dart"
      ],
      "settings": {
        "foreground": "#909090"
      }
    },
    {
      "name": "Namespaces and qualifiers",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "entity.name.scope-resolution",
        "support.other.namespace",
        "meta.module-reference",
        "entity.name.type.namespace",
        "entity.name.type.module",
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": {
        "foreground": "#FF9B00"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "support.class.component",
        "entity.name.tag.css",
        "entity.name.tag.reference.scss"
      ],
      "settings": {
        "foreground": "#50E191"
      }
    },
    {
      "name": "HTML tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "meta.property-name",
        "variable.css",
        "variable.scss",
        "variable.other.less",
        "entity.other.attribute-name.html.vue"
      ],
      "settings": {
        "foreground": "#00D2FA"
      }
    },
    {
      "name": "JSON / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "support.type.property-name.toml",
        "keyword.key.toml"
      ],
      "settings": {
        "foreground": "#00D2FA"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#00D2FA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#FA557D"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#00D2FA"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#909CC3"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#50E191"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#FF2D64"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FF9B00"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#00D2FA"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.string.newline"
      ],
      "settings": {
        "foreground": "#FF2D64"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": "#50E191",
    "modifier": "#50E191",
    "operator": "#FFFFFF",
    "comment": "#909CC3",
    "string": "#FA557D",
    "regexp": "#FF00FA",
    "number": "#AFCEA2",
    "namespace": "#FF9B00",
    "class": "#FF916E",
    "type": "#FF916E",
    "interface": "#FF916E",
    "struct": "#FF916E",
    "enum": "#FF916E",
    "typeParameter": "#FF916E",
    "function": "#00D2FA",
    "method": "#00D2FA",
    "property": "#00D2FA",
    "variable": "#00D2FA",
    "parameter": "#00D2FA",
    "enumMember": "#00D2FA",
    "event": "#00D2FA",
    "label": "#00D2FA",
    "macro": "#909090",
    "decorator": "#909090",
    "parameter.label:dart": "#00D2FA",
    "boolean:dart": "#FF916E",
    "string.escape:dart": "#FF00FA",
    "variable.importPrefix:dart": "#FF9B00",
    "source:dart": "#00D2FA",
    "annotation:dart": "#909090",
    "*.annotation:dart": "#00D2FA",
    "newOperator": "#50E191",
    "stringLiteral": "#FA557D",
    "numberLiteral": "#AFCEA2",
    "customLiteral": "#00D2FA"
  }
}
