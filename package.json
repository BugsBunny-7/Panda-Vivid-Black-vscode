{
  "name": "panda-vivid-black",
  "displayName": "Panda Vivid Black",
  "description": "Panda Vivid Black and Panda Modern Dark: near-black themes with semantic highlighting for Flutter, Go and Vue.",
  "version": "1.0.0",
  "publisher": "BennyWu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "black",
    "panda",
    "flutter",
    "go",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BugsBunny-7/Panda-Vivid-Black-vscode.git"
  },
  "contributes": {
    "themes": [
      {
        "label": "Panda Vivid Black",
        "uiTheme": "vs-dark",
        "path": "./themes/panda-vivid-black-color-theme.json"
      },
      {
        "label": "Panda Modern Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/panda-modern-dark-color-theme.json"
      }
    ]
  },
  "files": [
    "themes/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/**",
    "icon.png",
    "images/**"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0B0B0E",
    "theme": "dark"
  },
  "homepage": "https://github.com/BugsBunny-7/Panda-Vivid-Black-vscode#readme",
  "bugs": {
    "url": "https://github.com/BugsBunny-7/Panda-Vivid-Black-vscode/issues"
  }
}
